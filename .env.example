# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092

# ─── LLM Provider  (set ONE of the two below) ──────────────────
# Google Gemini (free tier available — recommended for demos)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT-4o (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Which provider to use: "gemini" or "openai" (default: gemini)
LLM_PROVIDER=gemini

# ─── Slack Alerts ──────────────────────────────────────────────
# Create an Incoming Webhook at https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#sre-alerts

# ─── Email Alerts (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASS=your_app_password_here
ALERT_EMAIL_TO=sre-team@yourcompany.com

# ─── Anomaly Detection Thresholds ──────────────────────────────
ERROR_RATE_WARNING_PCT=10
ERROR_RATE_CRITICAL_PCT=25
LATENCY_WARNING_MS=500
LATENCY_CRITICAL_MS=2000
AUTH_FAILURE_THRESHOLD=50
WINDOW_SECONDS=60
